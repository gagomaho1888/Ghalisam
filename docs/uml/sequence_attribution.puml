@startuml
' Ghalisam - Attribution d'une commande à un livreur
' Source : Utilisateurs/admin_views.py::attribuer_commande(), Utilisateurs/whatsapp.py

title Attribution d'une commande à un livreur (Administrateur)

skinparam shadowing false
skinparam sequence {
  ArrowColor #334155
  LifeBorderColor #334155
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #E2E8F0
  ActorBorderColor #1E293B
  ActorBackgroundColor #CBD5E1
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #F1F5F9
  GroupBorderColor #94A3B8
}

actor "Administrateur" as A
boundary "Navigateur" as N
control "Vue attribuer_commande\nadmin_views.py" as V
control "Décorateur\nadmin_required" as D
control "Notification" as NOTIF
control "Channel Layer" as CH
boundary "NotificationConsumer\n/ ws/notifications/" as WS
control "WhatsApp API" as WA
control "SMTP Gmail" as MAIL
actor "Livreur" as L
database "PostgreSQL" as DB

== Contrôle d'accès ==
A -> N : Ouvrir /admin-dashboard/commandes/<id>/attribuer/
N -> V : GET
V -> D : admin_required
D -> DB : user.is_superuser ?
alt Utilisateur non superutilisateur
  D --> N : Message "Accès réservé à l'administrateur"
else Autorisé
  D -> DB : SELECT livreurs actifs
  DB --> D : Liste des livreurs
  D --> N : Formulaire d'attribution
end

== Choix du livreur ==
A -> N : Sélectionner un livreur puis valider
N -> V : POST (livreur_id)
V -> D : admin_required
D -> DB : user.is_superuser ?

alt Aucun livreur sélectionné
  V -> DB : UPDATE commande SET livreur = NULL
  V --> N : Message "Attribution retirée"
else Livreur choisi
  V -> DB : get_object_or_404(Livreur, id, est_actif=True)
  DB --> V : Livreur
  V -> V : Memoire ancien_livreur
  V -> DB : UPDATE commande SET livreur = livreur.user

  alt Le livreur a changé
    V -> NOTIF : Notification.objects.create(\nlivreur, commande, message)
    NOTIF -> DB : INSERT notification

    V -> CH : group_send('livreur_<id>', nouvelle_commande)
    CH -> WS : Diffuser l'événement
    WS --> L : WebSocket\n(ticket, client, téléphone,\nadresse, montant)

    V -> WA : notifier_livreur_whatsapp(telephone, commande)
    WA --> L : Message WhatsApp

    V --> N : Message "Commande attribuée à <livreur>"
  else Même livreur
    V --> N : Message de confirmation
  end
end

@enduml
