# Django
DJANGO_SECRET_KEY="change-me-to-a-long-random-string"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS="monsite.com,www.monsite.com"

# Database
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis (optionnel – active le channel layer Redis pour les websockets)
REDIS_URL="redis://:password@localhost:6379/0"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN="votre-token-d-acces-permanent"
WHATSAPP_PHONE_NUMBER_ID="votre-phone-number-id"
WHATSAPP_DISABLE=False

# Email (Gmail SMTP)
EMAIL_HOST_USER="votre-email@gmail.com"
EMAIL_HOST_PASSWORD="mot-de-passe-d-application"

# Forcer Django à servir les fichiers media (sinon c'est nginx qui le fait)
# DJANGO_SERVE_MEDIA=True

# Logging
DJANGO_LOG_LEVEL=INFO
